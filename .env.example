# PostgreSQL 数据库
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5433"
POSTGRES_DB="your_database"
POSTGRES_USER="your_user"
POSTGRES_PASSWORD="your_password"

# MinIO API 地址（不是管理控制台地址）
MINIO_ENDPOINT="127.0.0.1:9000"
MINIO_ACCESS_KEY="your_access_key"
MINIO_SECRET_KEY="your_secret_key"
MINIO_BUCKET="eat-anything"
MINIO_PRIVATE_BUCKET="eat-anything-private"
MINIO_SECURE="false"
MINIO_PUBLIC_URL="http://127.0.0.1:9000"

APP_TIMEZONE="Asia/Shanghai"

# 学校天气（默认使用 Open-Meteo；切换 qweather 时再填写专属 Host 和 Key）
WEATHER_PROVIDER="open_meteo"
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
QWEATHER_API_HOST=""
QWEATHER_API_KEY=""

# FastAPI 运行配置
APP_ENV="development"
JWT_SECRET="dev-only-change-me-please-set-32-bytes"
JWT_EXPIRE_SECONDS="604800"
DEV_AUTH_ENABLED="false"
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_SUBSCRIBE_ENABLED="false"
WECHAT_NOTIFICATION_TEMPLATE_ID=""
WECHAT_NOTIFICATION_TITLE_KEY=""
WECHAT_NOTIFICATION_CONTENT_KEY=""
WECHAT_NOTIFICATION_TIME_KEY=""
WECHAT_ANNOUNCEMENT_TEMPLATE_ID=""
WECHAT_ANNOUNCEMENT_TITLE_KEY=""
WECHAT_ANNOUNCEMENT_CONTENT_KEY=""
WECHAT_ANNOUNCEMENT_TIME_KEY=""
MAX_UPLOAD_BYTES="5242880"
CORS_ORIGINS="http://localhost:5173"

# 示例数据管理员密码；首次运行初始化脚本时可自动生成到本地 .env
SEED_ADMIN_PASSWORD=""

# 初始化脚本使用的可选本地 Docker 容器名称
POSTGRES_CONTAINER="it_heima-postgres-1"
MINIO_CONTAINER="it_heima-minio-1"
