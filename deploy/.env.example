# EatAnything 部署环境变量模板
# 复制为 deploy/.env 后填写真实值：cp deploy/.env.example deploy/.env
# 本文件只包含变量名和安全占位符，严禁提交真实密钥。

# deploy/ 以生产部署为默认目标；production 会启用强制安全校验。
APP_ENV=production
APP_TIMEZONE=Asia/Shanghai

# 安全密钥：生产环境必须替换为随机值（openssl rand -base64 48）
JWT_SECRET=change-me-generate-32-bytes-random
JWT_EXPIRE_SECONDS=604800
DEV_AUTH_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# PostgreSQL（compose 内部网络使用服务名 postgres）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eat_anything
POSTGRES_USER=eat_anything
POSTGRES_PASSWORD=change-me-postgres-password

# MinIO（compose 内部网络使用服务名 minio；MINIO_PUBLIC_URL 为对外访问地址）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=eat-anything
MINIO_PRIVATE_BUCKET=eat-anything-private
MINIO_SECURE=false
MINIO_PUBLIC_URL=https://app.example.com/media

# 上传与跨域
MAX_UPLOAD_BYTES=5242880
CORS_ORIGINS=https://app.example.com
METRICS_ENABLED=true
METRICS_TOKEN=change-me-metrics-token
TRUSTED_PROXY_IPS=

# 可选：示例数据管理员密码（seed 脚本使用，生产不推荐）
SEED_ADMIN_PASSWORD=

# ---- Compose 自身配置 ----
# Compose project 名称。部署脚本会通过 --project-name 显式传入该值，
# 部署前必须改为该环境的唯一值，避免误用其他环境的容器、volume 或网络。
COMPOSE_PROJECT_NAME=eatanything-prod

# API 镜像与端口（默认只绑定本机 127.0.0.1）
API_IMAGE=eat-anything-api:1.0.0
API_BIND_HOST=127.0.0.1
API_PORT=8000
API_CONTAINER_PORT=8000

# 独立 Web 管理后台（访问 http://127.0.0.1:8080/admin/）
ADMIN_WEB_IMAGE=eat-anything-admin-web:1.0.0
ADMIN_WEB_BIND_HOST=127.0.0.1
ADMIN_WEB_PORT=8080

# 中间件镜像：固定到已验证的版本 tag，保证部署可复现；
# 升级镜像版本必须显式修改并重新验证，禁止退回 latest。
POSTGRES_IMAGE=postgres:16-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z

# MinIO API 宿主机映射（默认只绑定本机）
MINIO_BIND_HOST=127.0.0.1
MINIO_PORT=9000
# MinIO Console 默认不暴露端口；需要本地管理时取消注释
# MINIO_CONSOLE_PORT=9001

# 数据卷与网络名称
POSTGRES_VOLUME=eat-anything-prod-postgres-data
MINIO_VOLUME=eat-anything-prod-minio-data
NETWORK_NAME=eat-anything-prod-net

# ---- 可选：Caddy 正式域名与自动 HTTPS ----
# 设为 1 后 deploy.sh 会叠加 compose.production.yml 并启动 Caddy。
ENABLE_CADDY=0
APP_DOMAIN=app.example.com
CADDY_IMAGE=caddy:2.10.2-alpine
HTTP_BIND_HOST=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_HOST=0.0.0.0
HTTPS_PORT=443
CADDY_DATA_VOLUME=eat-anything-prod-caddy-data
CADDY_CONFIG_VOLUME=eat-anything-prod-caddy-config
